{
  "name": "follow-the-packet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "e2e": "playwright test",
    "structure": "node scripts/check-structure.ts",
    "dup": "jscpd src tests scripts",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm structure && pnpm dup && pnpm test",
    "check": "pnpm check:fast && pnpm test:browser && pnpm e2e"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "@mantine/hooks": "9.7.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.1.21",
    "just-compare": "2.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-no-comments": "1.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jscpd": "5.0.16",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

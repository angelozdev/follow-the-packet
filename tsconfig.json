{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["./src/*"], "@e2e/*": ["./tests/e2e/*"] },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "scripts", "playwright.config.ts"],
  "exclude": ["src/**/*.browser.test.ts", "src/**/*.browser.test.tsx", "src/testing/browser-play.ts"]
}
